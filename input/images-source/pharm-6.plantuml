@startuml

hide footbox

'!include ./style.iuml

Title Submit Medication Order [PHARM-6]

Participant "[[actors-transactions.html#order-placer Medication\nOrder\nPlacer]]" as OP
Participant "[[actors-transactions.html#order-receiver Medication\nOrder\nReceiver]]" as OF

activate OP
activate OF

OP -[hidden]> OF
alt Order Bundle Option
  OP -> OF: \tPOST [[StructureDefinition-IHEMedicationOrderNotificationBundle.html{Medication Order Notification Bundle} Order Notification Bundle]]\n\t(new or updated orders)
  OP <-- OF: \t200 OK / 202 Accepted\t
else Single Order Option
  OP -> OF: \tPOST /MedicationRequest [[StructureDefinition-IHEMedicationOrder.html{Medication Order} Medication Order]]\n\tor PUT /MedicationRequest/[id] (update)
  OP <-- OF: \t201 Created / 200 OK (+ MedicationRequest)\t
end
OP -[hidden]> OF

deactivate OP
deactivate OF

@enduml

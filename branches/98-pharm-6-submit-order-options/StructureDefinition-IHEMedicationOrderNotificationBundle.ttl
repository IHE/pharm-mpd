       fhir:short [ fhir:v "Coordination Task, when the Placer includes one (open issue: to be confirmed with HL7 COW)" ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ]
     ] [
       fhir:id [ fhir:v "Bundle.entry:task.resource" ] ;
       fhir:path [ fhir:v "Bundle.entry.resource" ] ;
       fhir:type ( [
         fhir:code [ fhir:v "Task"^^xsd:anyURI ]
       ] )
     ] )
  ] . # 

